# Kept only on the VPS as .env (never commit it).
PORT=3108
HOST=127.0.0.1
REFRESH_SECONDS=300

# Dirección aproximada obtenida a partir de las coordenadas. Esta consulta comparte
# coordenadas con Nominatim/OpenStreetMap; puede desactivarse con false.
GEOCODING_ENABLED=true
GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=monitoreo-relojes-adultos/0.2 (private-dashboard)

# Required before exposing the dashboard through a reverse proxy.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# AnyTracking / iGPS accounts.
IGPS_MAMA_ACCOUNT=
IGPS_MAMA_PASSWORD=
IGPS_PAPA_ACCOUNT=
IGPS_PAPA_PASSWORD=

# Validated against AnyTracking v5.2.99.
IGPS_ENDPOINT=http://app.igps123.com/openapiv3.asmx
IGPS_PROJECT=RFHZ
IGPS_APP_KEY=7DU2DJFDR8321
IGPS_TIME_ZONE=-06:00
IGPS_MAP_TYPE=Google
IGPS_LANGUAGE=es_NI
